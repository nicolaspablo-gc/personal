#! /bin/bash

set -euo pipefail

source "$(dirname "$(dirname "$(realpath "${BASH_SOURCE[0]}")")")/rc"

# clone public repo

if ! [ -d "$MY_MAIN_CONFIG_DIR" ]; then
    git clone https://github.com/nicolaspablo-gc/config "$MY_MAIN_CONFIG_DIR"
fi

# boostrap (stow + symlinks) config

cd "$MY_MAIN_CONFIG_DIR"
stow --dotfiles --no-folding --target="$HOME" --ignore=^dot-bashrc --ignore=^dot-profile .

cd "$MY_PERSONAL_CONFIG_DIR"
stow --dotfiles --no-folding --target="$HOME" --ignore=^.password-store .
ln -sf "$MY_PERSONAL_CONFIG_DIR/dot-password-store" "$HOME/.password-store"
