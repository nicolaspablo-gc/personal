#! /bin/bash

set -euo pipefail

source "$(dirname "$(dirname "$(realpath "${BASH_SOURCE[0]}")")")/rc"

# clone public repo

if ! [ -d "$MY_MAIN_EMACS_DIR" ]; then
    git clone https://github.com/nicolaspablo-gc/emacs "$MY_MAIN_EMACS_DIR"
fi

# symlink/bootstrap emacs

CONFIG_EMACS_DIR=~/.config/emacs

mkdir -p "$CONFIG_EMACS_DIR"
ln -sf "$MY_PERSONAL_EMACS_DIR"/personal-init.el "$CONFIG_EMACS_DIR/init.el"
ln -sf "$MY_PERSONAL_EMACS_DIR"/personal-early-init.el "$CONFIG_EMACS_DIR/early-init.el"
ln -sf "$MY_PERSONAL_EMACS_DIR"/abbrev_defs "$CONFIG_EMACS_DIR/abbrev_defs"
